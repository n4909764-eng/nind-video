# --- Whop subscriptions ---
# Company API key (Whop dashboard -> Developer -> API keys) with checkout_configuration:create; used to attach the user id to checkouts
WHOP_API_KEY=
# Signing secret (ws_...) of the webhook pointing to https://nind.pro/api/webhooks/whop
WHOP_WEBHOOK_SECRET=
# Public site URL used for the post-checkout redirect
PUBLIC_URL=https://nind.pro
