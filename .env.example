OPENROUTER_API_KEY=
MEDIA_PYTHON=.venv/bin/python
PORT=3000
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# WHOP_TOPUP_CHECKOUT_URL=
# --- Whop subscriptions ---
# Company API key (Whop dashboard -> Developer -> API keys) with checkout_configuration:create; used to attach the user id to checkouts
WHOP_API_KEY=
# Signing secret (ws_...) of the webhook pointing to https://nind.pro/api/webhooks/whop
WHOP_WEBHOOK_SECRET=
# Public site URL used for the post-checkout redirect
PUBLIC_URL=https://nind.pro
# Google sign-in (OAuth 2.0 authorization code). Authorized redirect URIs:
#   http://localhost:3100/api/auth/google/callback
#   https://nind.pro/api/auth/google/callback
# Authorized JavaScript origins: http://localhost:3100 and https://nind.pro
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional plan id overrides (defaults are the plans created in the "nind ai" Whop business)
# WHOP_PLAN_STARTER_MONTHLY=plan_PEoFZUohfP7EQ
# WHOP_PLAN_STARTER_ANNUAL=plan_qhQsIcxcgw0K7
# WHOP_PLAN_CREATOR3000_MONTHLY=plan_TZOKWqftoUoDz
# WHOP_PLAN_CREATOR3000_ANNUAL=plan_SbX1qP2M1PTDU
# WHOP_PLAN_CREATOR6000_MONTHLY=plan_8vgWPQY7cWOQB
# WHOP_PLAN_CREATOR6000_ANNUAL=plan_O1UuonQls7oeJ
# WHOP_PLAN_CREATOR9000_MONTHLY=plan_YCo3Tg5Bfz1gx
# WHOP_PLAN_CREATOR9000_ANNUAL=plan_xWkQKn3P9WH0Y

# --- E-mail (REQUIRED in production: e-mail login codes are sent through it; also the Help form) ---
# Without SMTP the e-mail code sign-in returns 503 on the live site (Google sign-in still works).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender of login codes, e.g. "nind ai <no-reply@nind.pro>" (domain needs SPF/DKIM for the SMTP provider)
MAIL_FROM=
# Sender of Help-form messages (sent to support@nind.pro); defaults to SMTP_USER
SUPPORT_FROM=

# --- Server ---
NODE_ENV=production
# Local development only: universal code 123456 + code shown in the API response.
# Ignored automatically when PUBLIC_URL is https://...  NEVER set on the live server.
# DEV_AUTH_CODES=1
# Rendering jobs running at the same time (CPU/RAM heavy) and per user
# MAX_CONCURRENT_JOBS=2
# MAX_JOBS_PER_USER=2
# Behind nginx/caddy the app trusts X-Forwarded-* from the first proxy; set 0 if exposed directly
# TRUST_PROXY=1
# WELCOME_CREDITS=20
# MIN_GENERATION_CREDITS=10
# MIN_EDIT_CREDITS=3
